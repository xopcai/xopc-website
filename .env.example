# 复制为服务器上的 .env 并填写（勿提交真实密钥）。
# 部署脚本在首次部署且不存在 .env 时，会从本文件复制一份。

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 强烈建议生产环境配置：匿名访问 api.github.com 极易触发限流，会导致 /api/download/latest-*.yml 等返回 502。
# 使用 classic PAT（read 即可）或 fine-grained token（Contents: Read）。
# GITHUB_TOKEN=

# 可选：大文件（zip/dmg 等）是否经本站 Node 代理。不设或 0 时默认 307 重定向到 GitHub（推荐，避免 nginx 截断大文件）。
# 若必须经本站下载，设为 1 并在 nginx 对 /api/download/ 关闭 proxy_buffering、加大超时。
# RELEASE_DOWNLOAD_PROXY_BINARIES=1

# 可选：CloakBrowser 代理缓存目录（默认 .data/cloakbrowser-cache）
# CLOAKBROWSER_CACHE_DIR=

# 可选：Whisper 模型代理缓存目录（默认 .data/voice-model-cache；设为空字符串可关闭源站磁盘缓存）
# VOICE_MODEL_CACHE_DIR=

# 可选：Whisper 模型上游镜像，多个地址用逗号分隔；始终保留 Hugging Face 作为最后回源
# VOICE_MODEL_UPSTREAM_BASE_URLS=https://your-model-mirror.example.com

# 可选：访问私有或受限 Hugging Face 模型时使用，只在服务端发往上游
# HF_TOKEN=
# Runtime artifact gateway. Set to an empty string to disable executable artifact serving.
RUNTIME_DOWNLOAD_CACHE_DIR=.data/runtime-cache
