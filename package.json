{
  "name": "xopc-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/prepare-blog.mjs && next dev",
    "build": "node scripts/prepare-blog.mjs && node scripts/check-tutorials.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "analytics:report": "node scripts/send-analytics-report.mjs",
    "analytics:report:dry-run": "node scripts/send-analytics-report.mjs --dry-run",
    "generate-favicon": "node scripts/generate-favicon.mjs",
    "tutorials:check": "node scripts/check-tutorials.mjs",
    "blog:prepare": "node scripts/prepare-blog.mjs",
    "blog:figures": "node scripts/generate-blog-figures.mjs && node scripts/generate-engineering-figures.mjs",
    "blog:check": "node scripts/check-blog.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "0.469.0",
    "next": "16.2.3",
    "next-intl": "^4.9.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
